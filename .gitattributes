# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files with LF line endings
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.cff text eol=lf
LICENSE text eol=lf

# Windows PowerShell and batch scripts require CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
