  "source": "Portable native Council source; personal state is created only after installation",
  "scope": "user profile; Codex, Gemini CLI",
  "schema_version": 1,
  "name": "The Council",
  "version": "3.0.0-alpha.4",
  "default_profile": "fulfillment",
  "specialists": [
    "the-architect",
    "the-builder",
    "the-coder",
    "the-codex",
    "the-coordinator",
    "the-curator",
    "the-gatekeeper",
    "the-pipelineer",
    "the-prover",
    "the-provisioner",
    "the-purifier",
    "the-relay",
    "the-renderer",
    "the-sentinel",
    "the-watcher"
  ],
  "workflows": [
    "brainstorming",
    "handoff",
    "repo-documentation",
    "systematic-debugging",
    "test-driven-development",
    "the-council-orchestration",
    "using-superpowers",
    "verification-before-completion",
    "writing-plans"
  ],
  "paths": {
    "skills": "skills",
    "shared": "instructions/shared.md",
    "host_rules": "rules/global.md",
    "workspace_rules": "rules/workspace.md",
    "exclusions": "exclusions/global.ignore"
  },
  "profiles": {
    "fulfillment": "profiles/fulfillment/profile.json"
  },
  "adapters": {
    "codex": "adapters/codex.json",
    "gemini": "adapters/gemini.json"
  },
  "execution": {
    "scope": "user",
    "routine_development": "allow_without_prompt",
    "respect_existing_authorization": true
  },
  "engine": {
    "status": "retired",
    "included": false
  },
  "memory": {
    "root": "memory",
    "default_scope": "legacy-shared",
    "available_scopes": [
      "legacy-shared",
      "workspace-session"
    ],
    "session_scope": "explicit opt-in; all models use the same workspace/session identity",
    "startup_policy": "stable context plus explicit per-client/chat task selection",
    "task_catalogue": "memory/task-context.json"
  },
  "source_roots": [
    "skills",
    "instructions",
    "rules",
    "profiles",
    "adapters",
    "exclusions",
    "scripts"
  ],
  "source_files": [
    "manifest.json",
    "README.md",
    "setup-council.ps1",
    ".gitignore",
    ".gitattributes",
    "docs/catalog.md",
    "docs/setup.md",
    "docs/structure.md",
    "docs/source-contract.md",
    "docs/code-change-pre-submit-sop.md",
    "docs/behavior-evaluation.md",
    "docs/architecture-flow.md",
    "docs/delivery-enhancements.md"
  ],
  "distribution": {
    "schema_version": 1,
    "kind": "native-only",
    "project_cleanup": false,
    "import_private_memory": false,
    "private_state_included": false,
    "retired_poc_included": false
  }
}
