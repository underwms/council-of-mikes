        <UserObject label="" mermaidId="e:Guard-&gt;Graph#0" mermaidBaseStyle="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;dashed=1;dashPattern=2 2;fixDash=1;startArrow=none;endArrow=block;endSize=8;jumpStyle=arc;jumpSize=12;strokeColor=#000000;exitX=0.5;exitY=0.99;entryX=0.87;entryY=0;strokeWidth=2;targetPerimeterSpacing=4;" mermaidBaseValue="" id="dIccFLpEfjdW09Kl_i50-65">
          <mxCell edge="1" parent="dIccFLpEfjdW09Kl_i50-1" source="dIccFLpEfjdW09Kl_i50-51" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;dashed=1;dashPattern=2 2;fixDash=1;startArrow=none;endArrow=block;endSize=8;jumpStyle=arc;jumpSize=12;strokeColor=#000000;exitX=0.5;exitY=0.99;entryX=0.87;entryY=0;strokeWidth=2;targetPerimeterSpacing=4;" target="dIccFLpEfjdW09Kl_i50-2">
