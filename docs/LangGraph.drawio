        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    CLI[\&quot;council.ps1 → Python CLI&lt;br/&gt;Task prompt + workspace\&quot;]\n    Context[\&quot;Resolve runtime context&lt;br/&gt;Workspace, Council root, memory root\&quot;]\n    Resume{\&quot;New run or resume?\&quot;}\n    New[\&quot;Create CouncilState&lt;br/&gt;run_id = thread_id\&quot;]\n    Load[\&quot;Load SQLite checkpoint&lt;br/&gt;Verify same workspace and runtime context\&quot;]\n\n    CLI --&gt; Context --&gt; Resume\n    Resume --&gt;|New| New\n    Resume --&gt;|Resume run-id| Load\n\n    subgraph Graph[\&quot;Native LangGraph StateGraph\&quot;]\n        Start((\&quot;START\&quot;))\n        Architect[\&quot;architect — GPT orchestrator&lt;br/&gt;Generate structured specialist plan&lt;br/&gt;Validate specialists, paths and test argv\&quot;]\n        Gate1{\&quot;plan_review — Gate 1&lt;br/&gt;Approve plan and commands?\&quot;}\n        Worker[\&quot;worker — active specialist&lt;br/&gt;Load specialist instructions&lt;br/&gt;Bind permitted tools to active model\&quot;]\n        Tools[\&quot;Tool conversation loop&lt;br/&gt;Read / write / patch files&lt;br/&gt;Run .NET / Deno tests or validator&lt;br/&gt;Maximum 12 model rounds\&quot;]\n        Prover[\&quot;prover — real subprocess verification&lt;br/&gt;Run every approved test command&lt;br/&gt;Record exit codes and available test counts\&quot;]\n        Passed{\&quot;All commands passed?\&quot;}\n        More{\&quot;More planned tasks?\&quot;}\n        Retry{\&quot;Repair retries remaining?&lt;br/&gt;Maximum 2 per task\&quot;}\n        Investigator[\&quot;investigation — Gemini&lt;br/&gt;Diagnose actual failed verification&lt;br/&gt;Using bounded process output\&quot;]\n        Role[\&quot;Increment retry count&lt;br/&gt;Choose repair model:&lt;br/&gt;GPT normally; optional Claude on retry 2\&quot;]\n        Audit[\&quot;gatekeeper&lt;br/&gt;Run actual workspace validator\&quot;]\n        AuditOK{\&quot;Workspace audit passed?\&quot;}\n        Gate2{\&quot;final_review — Gate 2&lt;br/&gt;Approve pre-submit result?\&quot;}\n        Complete[\&quot;COMPLETED\&quot;]\n        Fail[\&quot;FAILED&lt;br/&gt;Record bounded error\&quot;]\n        End((\&quot;END\&quot;))\n\n        Start --&gt; Architect --&gt; Gate1\n        Gate1 --&gt;|Approved| Worker\n        Gate1 --&gt;|Rejected| Fail\n\n        Worker --&gt; Tools\n        Tools --&gt;|Model finishes tool calls| Prover\n        Tools --&gt;|Tool error or round limit| Fail\n\n        Prover --&gt; Passed\n        Passed --&gt;|Yes| More\n        More --&gt;|Yes: advance task and reset retries| Worker\n        More --&gt;|No| Audit\n\n        Passed --&gt;|No| Retry\n        Retry --&gt;|Yes| Investigator --&gt; Role --&gt; Worker\n        Retry --&gt;|No| Fail\n\n        Audit --&gt; AuditOK\n        AuditOK --&gt;|Yes| Gate2\n        AuditOK --&gt;|No| Fail\n        Gate2 --&gt;|Approved| Complete --&gt; End\n        Gate2 --&gt;|Rejected| Fail --&gt; End\n    end\n\n    New --&gt; Start\n    Load --&gt;|Command resume: approval decision| Gate1\n    Load --&gt;|Command resume: approval decision| Gate2\n\n    Pause[\&quot;PAUSED at approval interrupt&lt;br/&gt;No input / noninteractive CLI&lt;br/&gt;Resume later using the same run-id\&quot;]\n    Gate1 -.-&gt;|interrupt| Pause\n    Gate2 -.-&gt;|interrupt| Pause\n    Pause -.-&gt; Load\n\n    State[(\&quot;CouncilState&lt;br/&gt;Plan + task index + active role&lt;br/&gt;Test evidence + retry count&lt;br/&gt;Workspace identity + status\&quot;)]\n    DB[(\&quot;SQLite SqliteSaver&lt;br/&gt;memory/council_checkpoints.db&lt;br/&gt;Durable state and approval interrupts\&quot;)]\n    Guard[\&quot;Every node wrapper&lt;br/&gt;Validate run and workspace identity&lt;br/&gt;Enforce graph step budget: default 100&lt;br/&gt;Convert execution exceptions to FAILED\&quot;]\n\n    State -.-&gt; Graph\n    Graph -.-&gt; DB\n    DB -.-&gt; Load\n    Guard -.-&gt; Graph\n\n    classDef approval fill:#fff3cd,stroke:#b58105,color:#332600\n    classDef failure fill:#f8d7da,stroke:#b02a37,color:#58151c\n    classDef success fill:#d1e7dd,stroke:#198754,color:#0a3622\n    classDef storage fill:#dbeafe,stroke:#2563eb,color:#172554\n    class Gate1,Gate2,Pause approval\n    class Fail failure\n    class Complete success\n    class State,DB storage\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="dIccFLpEfjdW09Kl_i50-1">
